{
  "name": "sao-rpg-database-node",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w @sao/api\" \"npm run dev -w @sao/web\"",
    "build": "npm run build -ws --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "npm run prisma:generate -w @sao/api",
    "db:migrate": "npm run prisma:migrate -w @sao/api",
    "db:seed": "npm run prisma:seed -w @sao/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "vitest": "^3.2.4"
  }
}
